{
  "name": "create-tsdown",
  "version": "0.0.3",
  "packageManager": "pnpm@10.11.0",
  "description": "The Elegant Bundler for Libraries",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Gugustinette/create-tsdown#readme",
  "bugs": {
    "url": "https://github.com/Gugustinette/create-tsdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gugustinette/create-tsdown.git"
  },
  "author": "三咲智子 Kevin Deng <sxzz@sxzz.moe>",
  "funding": "https://github.com/sponsors/sxzz",
  "files": [
    "dist",
    "esm-shims.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./run": "./dist/run.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "bin": {
    "create-tsdown": "./dist/run.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint --cache --max-warnings 0 .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "node --import @oxc-node/core/register ./src/run.ts",
    "dev:migrate": "node --import @oxc-node/core/register ./src/run.ts migrate --dry-run",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "ansis": "^4.2.0",
    "cac": "^6.7.14",
    "debug": "^4.4.3",
    "diff": "^8.0.2",
    "giget": "^2.0.0",
    "rolldown": "1.0.0-beta.43"
  },
  "devDependencies": {
    "@oxc-node/core": "^0.0.32",
    "@sxzz/eslint-config": "^7.2.7",
    "@sxzz/prettier-config": "^2.2.4",
    "@sxzz/test-utils": "^0.5.11",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.7.2",
    "bumpp": "^10.3.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.5.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prettier": "@sxzz/prettier-config"
}
